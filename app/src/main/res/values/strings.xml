    <!-- MB-S6-002 设置页 -->
    <string name="settings_intro">备份、恢复与诊断都在本机完成。应用没有网络权限，数据不会离开这台设备。</string>
    <string name="settings_footer">数据保存在本机 · 离线可用</string>

    <string name="settings_section_backup">数据备份</string>
    <string name="settings_backup_body">生成完整归档：SQLite 数据库 + 附件索引，保存为 ZIP。可用于换机或灾难恢复。</string>
    <string name="settings_backup_action">立即备份</string>
    <string name="settings_backup_running">正在生成备份…</string>
    <string name="settings_backup_success">备份已保存：%1$s（%2$s）</string>
    <string name="settings_backup_hint">保存位置由系统文件选择器决定；应用不保留你的选择。</string>

    <string name="settings_section_restore">数据恢复</string>
    <string name="settings_restore_body">从 MISEBASE 备份 ZIP 恢复。恢复会覆盖当前所有数据，完成后应用会重启。</string>
    <string name="settings_restore_action">从备份恢复</string>
    <string name="settings_restore_running">正在校验并恢复…</string>
    <string name="settings_restore_success_inline">已恢复备份 %1$s（schema v%2$d）。</string>
    <string name="settings_restore_clear">清除提示</string>
    <string name="settings_restore_hint">若备份版本与当前应用不兼容，恢复会被拒绝，现有数据不受影响。</string>
    <string name="settings_restore_confirm_title">确认覆盖恢复？</string>
    <string name="settings_restore_confirm_body">将用所选备份恢复数据：\n%1$s\n\n当前所有食材、酱汁、菜谱、库存与附件都会被覆盖，恢复完成后应用会重启。此操作不可撤销。</string>
    <string name="settings_restore_confirm_action">覆盖并恢复</string>
    <string name="settings_restore_unknown_file">已选择的备份文件</string>
    <string name="settings_cancel">取消</string>

