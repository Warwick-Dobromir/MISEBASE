from pathlib import Path
import subprocess

root = Path(".")
files = [
    "core/designsystem/src/main/java/com/culinary/core/designsystem/component/ArchiveEditor.kt",
    "feature/sauces/src/main/java/com/culinary/feature/sauces/SauceEditorSections.kt",
    "feature/sauces/src/main/java/com/culinary/feature/sauces/SauceEditorScreen.kt",
    "feature/sauces/src/main/java/com/culinary/feature/sauces/SauceEditorComponents.kt",
    "feature/recipes/src/main/java/com/culinary/feature/recipes/RecipeEditorScreen.kt",
    "feature/recipes/src/main/java/com/culinary/feature/recipes/RecipeMethodEditor.kt",
    "feature/recipes/src/main/java/com/culinary/feature/recipes/RecipeEditorViewModel.kt",
]

parts = []

def command(title, args):
    result = subprocess.run(
        args, cwd=root, text=True,
        stdout=subprocess.PIPE, stderr=subprocess.STDOUT
    )
    parts.append(f"\n===== {title} =====\n{result.stdout}")

command("CURRENT BRANCH", ["git", "branch", "--show-current"])
command("GIT STATUS", ["git", "status", "--short"])
command("DIFF STAT", ["git", "diff", "--stat"])
command("DIFF CHECK", ["git", "diff", "--check"])

for name in files:
    path = root / name
    if path.exists():
        content = path.read_text(encoding="utf-8")
        parts.append(f"\n===== FILE: {name} =====\n{content}")
    else:
        parts.append(f"\n===== FILE MISSING: {name} =====")

Path("返回结果").write_text("\n".join(parts), encoding="utf-8")
print("已生成项目根目录的「返回结果」文件。")
print("请将它更新到 GitHub 仓库的「返回结果」文件。")
