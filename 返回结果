from pathlib import Path

# 1. 扩展公共图片组件，允许领域模块传入自己的文案
p = Path(
    "core/designsystem/src/main/java/com/culinary/core/designsystem/component/ArchiveEditor.kt"
)
s = p.read_text(encoding="utf-8")

signature = '    showActions: Boolean = true,\n) {'
assert s.count(signature) == 1, "ArchiveEditorImageBox 函数签名不唯一或已变化"

s = s.replace(
    signature,
    '    showActions: Boolean = true,\n'
    '    replaceLabel: String = "替换",\n'
    '    deleteLabel: String = "删除",\n'
    ') {',
    1,
)

assert s.count('text = "替换",') == 1, "替换文案位置异常"
assert s.count('text = "删除",') == 1, "删除文案位置异常"

s = s.replace('text = "替换",', 'text = replaceLabel,', 1)
s = s.replace('text = "删除",', 'text = deleteLabel,', 1)

p.write_text(s, encoding="utf-8")


# 2. 酱汁编辑器改用现有公共组件
p = Path(
    "feature/sauces/src/main/java/com/culinary/feature/sauces/SauceEditorSections.kt"
)
s = p.read_text(encoding="utf-8")

imports = [
    "import com.culinary.core.designsystem.component.ArchiveEditorDragHandle",
    "import com.culinary.core.designsystem.component.ArchiveEditorImageBox",
    "import com.culinary.core.designsystem.component.ArchiveEditorInlineField",
    "import com.culinary.core.designsystem.component.ArchiveEditorNotesBox",
    "import com.culinary.core.designsystem.component.ArchiveEditorSectionHeader",
]

marker = "package com.culinary.feature.sauces\n"
assert s.startswith(marker), "SauceEditorSections.kt 文件结构异常"

for item in imports:
    assert item not in s, f"重复导入：{item}"

s = s.replace(marker, marker + "\n" + "\n".join(imports) + "\n", 1)

replacements = {
    "SauceSectionHeader(": "ArchiveEditorSectionHeader(",
    "EditorInlineField(": "ArchiveEditorInlineField(",
    "DragHandle(": "ArchiveEditorDragHandle(",
    "EditorImageBox(": "ArchiveEditorImageBox(",
    "NotesField(": "ArchiveEditorNotesBox(",
}

for old, new in replacements.items():
    count = s.count(old)
    assert count > 0, f"没有找到待替换组件：{old}"
    s = s.replace(old, new)

for label in [
    "emptyLabel = stringResource(R.string.sauces_hero_upload),",
    "emptyLabel = stringResource(R.string.sauces_step_upload),",
]:
    assert s.count(label) == 1, f"图片区域位置异常：{label}"
    s = s.replace(
        label,
        label + "\n"
        "            replaceLabel = stringResource(R.string.sauces_image_replace),\n"
        "            deleteLabel = stringResource(R.string.sauces_image_delete),",
        1,
    )

p.write_text(s, encoding="utf-8")

print("第一批公共组件迁移完成。")
PY
