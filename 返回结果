 */
@Composable
internal fun RecipeMethodEditor(
    state: RecipeEditorUiState,
    stepImageBytes: Map<String, ByteArray?>,
    onAddStep: () -> Unit,
    onStepTitleChange: (String, String) -> Unit,
    onStepBodyChange: (String, String) -> Unit,
    onStepTimeChange: (String, Int) -> Unit,
