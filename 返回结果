            state = state,
            onYieldAmountChange = onYieldAmountChange,
            onOpenYieldUnit = onOpenYieldUnit,
            onMinRangeAmountChange = onMinRangeAmountChange,
            onOpenMinRangeUnit = onOpenMinRangeUnit,
            onServingsChange = onServingsChange,
