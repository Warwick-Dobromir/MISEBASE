) {
    when (active) {
        EditorPicker.NONE -> Unit
        EditorPicker.YIELD_UNIT ->
            UnitPickerDialog(
                units = state.units,
                selectedId = state.yieldUnit?.id?.value,
                onSelect = onSelectYieldUnit,
                onDismiss = onDismiss,
