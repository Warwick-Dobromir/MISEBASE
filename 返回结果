from pathlib import Path

def patch(path, replacements):
    p = Path(path)
    original = p.read_text(encoding="utf-8")
    updated = original

    for old, new, expected in replacements:
        count = updated.count(old)
        if count != expected:
            raise SystemExit(
                f"ABORT: {path}\n"
                f"Expected {expected} occurrence(s), found {count}:\n{old[:240]}"
            )
        updated = updated.replace(old, new)

    if updated == original:
        raise SystemExit(f"ABORT: no changes generated for {path}")

    p.write_text(updated, encoding="utf-8", newline="")
    print(f"PATCH APPLIED: {path}")

