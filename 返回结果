            error.field == "recipe.version" -> "草稿状态已变化，请重新打开编辑。"
            error.field == "servings" -> "目标份数必须是大于 0 的数字。"
            error.field.startsWith("recipe.component") -> "组成行数量必须是大于 0 的数字。"
            else -> "输入不合法。"
